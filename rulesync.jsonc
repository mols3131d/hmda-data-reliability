{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": {
    "claudecode": ["rules", "skills", "subagents"],
    "codexcli": ["rules", "skills", "subagents"],
    "copilot": ["rules", "skills", "subagents"],
    "copilotcli": ["rules", "skills", "subagents"],
    "antigravity-ide": ["rules", "skills", "subagents"],
    "antigravity-cli": ["rules", "skills", "subagents"]
  },
  "outputRoots": ["."],
  "sources": [
    {
      "source": "mols3131d/mols-agent-assets",
      "skills": [
        "code-flow-map",
        "mols-agent-asset",
        "mols-agent-asset-find",
        "mols-ci-design",
        "mols-clarify-code",
        "mols-clarify-runtime",
        "mols-code-comprehension-refactor",
        "mols-coding-context",
        "mols-coding-context-python",
        "mols-dev-env-bootstrap-design",
        "mols-documentation",
        "mols-loops",
        "mols-markdown-dashboard",
        "mols-markdown-maintenance",
        "mols-mermaid-chart",
        "mols-mermaid-diagram",
        "mols-openspec-customize",
        "mols-project-task-command-design",
        "mols-tach",
        "mols-text-optimizer"
      ],
      "transport": "github",
      "ref": "main",
      "path": "src/rulesync/.rulesync/skills"
    },
    {
      "source": "dietrichgebert/ponytail",
      "skills": ["ponytail"],
      "transport": "github",
      "ref": "main",
      "path": "skills"
    }
  ]
}
