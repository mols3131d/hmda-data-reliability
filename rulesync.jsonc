{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": {
    "claudecode": ["rules", "skills"],
    "codexcli": ["rules", "skills"],
    "copilot": ["rules", "skills"],
    "copilotcli": ["rules", "skills"],
    "antigravity-ide": ["rules", "skills"],
    "antigravity-cli": ["rules", "skills"]
  },
  "outputRoots": ["."],
  "sources": [
    {
      "source": "mols3131d/mols-agent-assets",
      "skills": [
        "mols-agent-asset",
        "mols-clarify-code",
        "mols-clarify-runtime",
        "mols-code-comprehension-refactor",
        "mols-coding-context",
        "mols-coding-context-python",
        "mols-loops",
        "mols-markdown-dashboard",
        "mols-markdown-for-human",
        "mols-markdown-maintenance",
        "mols-mermaid-chart",
        "mols-mermaid-diagram"
      ],
      "transport": "github",
      "ref": "main",
      "path": "src/rulesync/.rulesync/skills"
    }
  ]
}
