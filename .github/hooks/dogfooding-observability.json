{
    "version": 1,
    "hooks": {
        "SubagentStart": [
            {
                "type": "command",
                "command": "uv run python scripts/log_agent_event.py",
                "cwd": ".",
                "timeout": 5
            }
        ],
        "PostToolUse": [
            {
                "type": "command",
                "command": "uv run python scripts/log_agent_event.py",
                "cwd": ".",
                "timeout": 5
            }
        ],
        "SubagentStop": [
            {
                "type": "command",
                "command": "uv run python scripts/log_agent_event.py",
                "cwd": ".",
                "timeout": 5
            }
        ],
        "Stop": [
            {
                "type": "command",
                "command": "uv run python scripts/log_agent_event.py",
                "cwd": ".",
                "timeout": 5
            }
        ]
    }
}
