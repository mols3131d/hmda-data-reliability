{
    "version": 1,
    "hooks": {
        "SubagentStop": [
            {
                "type": "command",
                "command": "uv run python scripts/log_agent_event.py",
                "timeout": 5
            }
        ],
        "PostToolUse": [
            {
                "type": "command",
                "command": "uv run python scripts/log_agent_event.py",
                "timeout": 5
            }
        ]
    }
}
