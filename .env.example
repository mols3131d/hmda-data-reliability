# === === === System and Local Development Environment === === ===
LOG_LEVEL=INFO
TZ=Asia/Seoul
PYTHONPATH=src

# === === === Temporary File, Cache, and Artifact Isolation === === ===
DATA_DIR=./data
CACHE_DIR=./.cache
UV_CACHE_DIR=./.cache/uv
TMPDIR=./.tmp
TEMP=./.tmp
TMP=./.tmp

# Generated local artifact root
PROJECT_PIVOT_ARTIFACTS_DIR=./.local/artifacts

# === === === Data Pipeline and Database === === ===
# dbt DuckDB database file
PROJECT_PIVOT_DUCKDB_PATH=data/project_pivot.duckdb

# HMDA raw data and EDA default path
PROJECT_PIVOT_SOURCE_ROOT=data/raw/hmda
HMDA_EDA_DATA_PATH=data/raw/hmda/year_2025.csv

# Evaluation report output path
PROJECT_PIVOT_REPORT_PATH=scratch/evaluation/pipeline_run_report.md

# === === === dbt Configuration === === ===
DBT_PROFILES_DIR=dbt
DBT_SEND_ANONYMOUS_USAGE_STATS=false

# === === === Local API Server Configuration === === ===
PROJECT_PIVOT_API_HOST=127.0.0.1
PROJECT_PIVOT_API_PORT=8000
