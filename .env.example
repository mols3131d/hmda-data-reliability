# Project Pivot local environment template.
# Application runtime reads process environment; local agent tooling loads `.env` directly.

# Data pipeline
PROJECT_PIVOT_DUCKDB_PATH=data/project_pivot.duckdb
PROJECT_PIVOT_SOURCE_ROOT=data/raw/hmda
PROJECT_PIVOT_SOURCE_YEAR=2025

# dbt CLI
DBT_PROFILES_DIR=dbt
DBT_SEND_ANONYMOUS_USAGE_STATS=false

# Local agent tooling
PROJECT_PIVOT_ARTIFACTS_DIR=.local/artifacts
