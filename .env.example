# === === === System and Local Development Environment === === ===
# Copy this file to .env and load it with `uv run --env-file .env <command>`.
LOG_LEVEL=INFO
TZ=Asia/Seoul
PYTHONPATH=src

# === === === Temporary File, Cache, and Artifact Isolation === === ===
DATA_DIR=./data
CACHE_DIR=./.cache
UV_CACHE_DIR=./.cache/uv
TMPDIR=./.tmp
TEMP=./.tmp
TMP=./.tmp

# Generated local artifact root
HMDA_RELIABILITY_ARTIFACTS_DIR=./.local/artifacts

# === === === Opt-in Agentic Review Live Proof === === ===
# The default test suite never reads these values or performs a provider call.
HMDA_AGENTIC_REVIEW_LIVE=false
# 실제 호출 전 서버의 설치된 모델 태그를 확인하고 LIVE=true로 바꾼다.
# staged는 세 단계의 텍스트를 수집하고 결과 JSON을 코드로 조립한다.
# 현재 staged 프롬프트 하나를 사용하며 모드나 version을 선택하지 않는다.
HMDA_AGENTIC_REVIEW_BASE_URL=http://localhost:11434/v1
HMDA_AGENTIC_REVIEW_API_KEY=ollama
HMDA_AGENTIC_REVIEW_MODEL=qwen3.5:4b-8k-local
# `auto` resolves the current Git HEAD and requires a clean tracked worktree.
HMDA_AGENTIC_REVIEW_PROJECT_REVISION=auto
# 아래 값은 staged 로컬 운영 예제이며, 실제 모델에서 검증한 최적값이 아니다.
# TIMEOUT_SECONDS는 HTTP 쓰기·연결 풀 대기에 적용한다(미지정 시 30초).
# 연결은 CONNECT_TIMEOUT_SECONDS를 사용하며 미지정 시 10초다.
# 읽기는 READ_TIMEOUT_SECONDS → 명시한 TIMEOUT_SECONDS → 300초 순으로 적용한다.
# HMDA_AGENTIC_REVIEW_TIMEOUT_SECONDS=30
HMDA_AGENTIC_REVIEW_CONNECT_TIMEOUT_SECONDS=10
HMDA_AGENTIC_REVIEW_READ_TIMEOUT_SECONDS=300
HMDA_AGENTIC_REVIEW_MAX_RETRIES=0
# 단계·workflow 예산은 후속 시도 시작과 응답 채택을 제한하며 hard cancel이 아니다.
HMDA_AGENTIC_REVIEW_STAGE_BUDGET_SECONDS=360
HMDA_AGENTIC_REVIEW_WORKFLOW_BUDGET_SECONDS=1200
HMDA_AGENTIC_REVIEW_MAX_OUTPUT_TOKENS=1024
HMDA_AGENTIC_REVIEW_MAX_PROMPT_BYTES=65536
HMDA_AGENTIC_REVIEW_MAX_OUTPUT_BYTES=32768

# === === === Data Pipeline and Database === === ===
# dbt DuckDB database file
HMDA_RELIABILITY_DUCKDB_PATH=data/hmda_reliability.duckdb

# HMDA raw data and EDA default path
HMDA_RELIABILITY_SOURCE_ROOT=data/raw/hmda
HMDA_RELIABILITY_SOURCE_YEAR=2025
HMDA_EDA_DATA_PATH=data/raw/hmda/year_2025.csv

# === === === dbt Configuration === === ===
DBT_PROFILES_DIR=dbt
DBT_SEND_ANONYMOUS_USAGE_STATS=false

# === === === Apache Airflow Local Runtime === === ===
# dotenv variable substitution makes these absolute while keeping the example portable.
AIRFLOW_HOME=${PWD}/.local/airflow
AIRFLOW__CORE__DAGS_FOLDER=${PWD}/src/hmda_reliability/orchestration/dags
AIRFLOW__CORE__LOAD_EXAMPLES=false
