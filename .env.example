# Project Pivot 로컬 실행 기본값

# dbt DuckDB 대상 파일
PROJECT_PIVOT_DUCKDB_PATH=data/project_pivot.duckdb

# MVP pipeline 원천 데이터 위치
PROJECT_PIVOT_SOURCE_ROOT=data/raw/tlc

# MVP pipeline evaluation report 위치
PROJECT_PIVOT_REPORT_PATH=scratch/evaluation/pipeline_run_report.md

# dbt profile 위치
DBT_PROFILES_DIR=dbt

# FastAPI 로컬 서버 기본값
PROJECT_PIVOT_API_HOST=127.0.0.1
PROJECT_PIVOT_API_PORT=8000

# dbt 익명 사용 통계 비활성화
DBT_SEND_ANONYMOUS_USAGE_STATS=false

# src layout import 경로
PYTHONPATH=src

# sandbox/CI에서 홈 캐시 쓰기 실패를 피하기 위한 uv cache 경로
UV_CACHE_DIR=/tmp/uv-cache
