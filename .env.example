# === === === System and Local Development Environment === === ===
# Copy this file to .env and load it with `uv run --env-file .env <command>`.
LOG_LEVEL=INFO
TZ=Asia/Seoul
PYTHONPATH=src

# === === === Temporary File, Cache, and Artifact Isolation === === ===
DATA_DIR=./data
CACHE_DIR=./.cache
UV_CACHE_DIR=./.cache/uv
TMPDIR=./.tmp
TEMP=./.tmp
TMP=./.tmp

# Generated local artifact root
HMDA_RELIABILITY_ARTIFACTS_DIR=./.local/artifacts

# === === === Langfuse Native Review AI === === ===
# uv sync: Langfuse SDK 4.15.6은 기본 의존성이다.
# 최초 등록(원격 쓰기):
# uv run --env-file .env python -m hmda_reliability.review_ai.evaluation.setup --model qwen3.5:4b-8k-local
# 반복 실험(실제 모델 호출):
# uv run --env-file .env python -m hmda_reliability.review_ai.evaluation.experiment --dataset hmda-review-ai-staged-v1 --name staged-review
# HMDA 적재 없이 합성 사례를 native Dataset task로 실행한다.
# 기존 LIVE/ENABLED opt-in과 HMDA_AGENTIC_REVIEW_*/HMDA_LANGFUSE_* 설정은 사용하지 않는다.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# SDK HTTP timeout이다. 모델 timeout이나 flush/프로세스 강제 종료 한도가 아니다.
LANGFUSE_TIMEOUT=30

# SDK task가 로컬 OpenAI-compatible 제공자를 호출한다.
# 실제 설치된 모델 태그를 setup --model에 지정한다(예: qwen3.5:4b-8k-local).
# 실행 모델·max_tokens·읽기 timeout은 evidence_review prompt config에서 관리한다.
# setup 시작값: max_tokens=1024, timeout=300초. 연결 10초, Runtime retry 0회.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
# Cloud UI에서 직접 모델을 호출하려면 별도의 접근 가능한 HTTPS 연결이 필요하다.
# 위 localhost는 이 SDK task를 실행하는 머신의 주소다.

# === === === Data Pipeline and Database === === ===
# dbt DuckDB database file
HMDA_RELIABILITY_DUCKDB_PATH=data/hmda_reliability.duckdb

# HMDA raw data and EDA default path
HMDA_RELIABILITY_SOURCE_ROOT=data/raw/hmda
HMDA_RELIABILITY_SOURCE_YEAR=2025
HMDA_EDA_DATA_PATH=data/raw/hmda/year_2025.csv

# === === === dbt Configuration === === ===
DBT_PROFILES_DIR=dbt
DBT_SEND_ANONYMOUS_USAGE_STATS=false

# === === === Apache Airflow Local Runtime === === ===
# dotenv variable substitution makes these absolute while keeping the example portable.
AIRFLOW_HOME=${PWD}/.local/airflow
AIRFLOW__CORE__DAGS_FOLDER=${PWD}/src/hmda_reliability/orchestration/dags
AIRFLOW__CORE__LOAD_EXAMPLES=false
